// Replica interface for rln_ui's backend (runs as the core module rln_ui_backend when
// metadata has "backend":"module"). QML gets it via logos.module("rln_ui") and reads these
// READONLY props; the backend publishes RLN + payer status onto them. No action slots: the
// node funds and registers its own membership (the user only funds the payer account).
class RlnUi
{
    PROP(QString nodeRlnState="unknown" READONLY)     // delivery_module.rlnState().state
    PROP(QString deliveryStatus="starting" READONLY)  // delivery connection status
    PROP(QString membershipState="unknown" READONLY)  // unknown|pending|active|failed
    PROP(int membershipCount=0 READONLY)
    PROP(QString quota="n/a" READONLY)                // epoch quota summary
    PROP(QString registryId="" READONLY)              // rln registry (fleet)
    PROP(QString rlnIdentifier="" READONLY)
    PROP(int epochSizeSec=0 READONLY)

    // Payer account funding model (liblogos_lez_rln_module): the node derives a payer account on
    // LEZ, the user funds it (no faucet; bridge from the Logos Blockchain), the node self-registers.
    PROP(QString payerAccount="" READONLY)            // payer account, hex64
    PROP(QString payerAccountB58="" READONLY)         // base58 of the payer account (for display/copy)
    PROP(QString payerBalance="" READONLY)            // live native balance, decimal string
    PROP(QString fundTargetUnits="" READONLY)         // suggested fund amount, decimal string
    PROP(QString walletState="pending" READONLY)      // pending|ready|failed

    SLOT(void start())
    SLOT(void refresh())
}
